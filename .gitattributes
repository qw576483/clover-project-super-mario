# git-lfs：原版素材打包件（*.zip）走 LFS
# 原版素材目录本身留在 .gitignore 里；入库的是仓库根的 原版资源.zip。
*.zip filter=lfs diff=lfs merge=lfs -text

# 引擎/Unity 二进制：按二进制处理，免得 git 做行尾转换、diff 刷屏
*.png  binary
*.jpg  binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.unity binary
*.prefab binary
*.asset binary
*.controller binary
*.anim binary
